<Window x:Class="pr3_Shitov_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr3_Shitov_WPF"
        mc:Ignorable="d"
        Title="Заказ печатной продукции" Height="650" Width="870" Background="#f0f5f5">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#7b505f" Padding="14">
            <TextBlock Text="Заказ печатной продукции" Foreground="White" FontSize="20" FontWeight="Bold"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#e0ebf0"
                BorderBrush="#C9D3DB" Padding="14" Margin="0,5,0,0">
            <TextBlock Text="Макет не проверен" Foreground="#727c87"/>
        </Border>

        <Border DockPanel.Dock="Left" Width="170" Background="#F5F7FA"
                BorderBrush="#D5DDE4" BorderThickness="1" Padding="12" Margin="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Категории" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="Документы" Margin="0,0,0,8" Padding="8,6"/>
                <Button Content="Визитки"   Margin="0,0,0,8" Padding="8,6"/>
                <Button Content="Буклеты"   Margin="0,0,0,8" Padding="8,6"/>
                <Button Content="Плакаты"   Margin="0,0,0,8" Padding="8,6"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Right" Background="#F5F7FA" BorderBrush="#D5DDE4" BorderThickness="1" Padding="12" Margin="10" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Заказчик" Margin="0,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон" Margin="0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Вид продукции" Margin="0,6"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" SelectedIndex="0">
                            <ComboBoxItem Content="Документы"/>
                            <ComboBoxItem Content="Визитки"/>
                            <ComboBoxItem Content="Буклеты"/>
                            <ComboBoxItem Content="Плакаты"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Формат" Margin="0,6"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" SelectedIndex="0">
                            <ComboBoxItem Content="A4"/>
                            <ComboBoxItem Content="A5"/>
                            <ComboBoxItem Content="A3"/>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Тираж" Margin="0,6"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Text="100"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Тип бумаги" Margin="0,6"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,3" SelectedIndex="0">
                            <ComboBoxItem Content="Офсетная"/>
                            <ComboBoxItem Content="Мелованная"/>
                            <ComboBoxItem Content="Картон"/>
                        </ComboBox>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Цветность" Margin="0,6"/>
                        <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,3" SelectedIndex="0">
                            <ComboBoxItem Content="Чёрно-белая"/>
                            <ComboBoxItem Content="Цветная"/>
                        </ComboBox>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Срок готовности" Margin="0,6"/>
                        <DatePicker Grid.Row="7" Grid.Column="1" Margin="0,3"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="20, 0, 0, 0">
                        <Border Height="200" Background="#F0F4F8"
                            BorderBrush="#B9C6D2" BorderThickness="1">
                            <TextBlock Text="Предпросмотр макета" Foreground="#8A98A6" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="Выбрать файл" Margin="0,8,0,0" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="Примечание к заказу" Margin="0,12,0,4"/>
                <TextBox Grid.Row="2" Height="70" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Text="Дополнительная обработка" Margin="0,15,0,0" Foreground="#425c73" FontWeight="Bold"/>
                <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                    <CheckBox Content="Ламинирование" Margin="0,0,16,6"/>
                    <CheckBox Content="Скрепление" Margin="0,0,16,6"/>
                    <CheckBox Content="Переплёт" Margin="0,0,16,6"/>
                    <CheckBox Content="Обрезка" Margin="0,0,16,6"/>
                    <CheckBox Content="Скругление углов" Margin="0,0,16,6"/>
                </WrapPanel>

                <StackPanel Grid.Row="5" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Оформить" Width="90" Padding="8" Margin="0,0,8,0"/>
                    <Button Content="Отмена" Width="90" Padding="8"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
